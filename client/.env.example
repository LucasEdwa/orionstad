# EmailJS Configuration
# Copy this file to .env and fill in your EmailJS credentials

# EmailJS Service ID - Get this from your EmailJS dashboard
VITE_EMAILJS_SERVICE_ID=your_service_id_here

# EmailJS Template ID for Booking Form (Home page)
VITE_EMAILJS_TEMPLATE_IDHOME=your_booking_template_id_here

# EmailJS Template ID for Contact Form
VITE_EMAILJS_TEMPLATE_IDCONTACT=your_contact_template_id_here

# EmailJS Public Key - Get this from your EmailJS account settings
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

# Google Analytics (optional)
VITE_GA_MEASUREMENT_ID=your_ga_measurement_id_here

# Example values (replace with your actual values):
# VITE_EMAILJS_SERVICE_ID=service_abcd1234
# VITE_EMAILJS_TEMPLATE_IDHOME=template_home_xyz789
# VITE_EMAILJS_TEMPLATE_IDCONTACT=template_contact_abc123
# VITE_EMAILJS_PUBLIC_KEY=abcdef123456
