# Apache config for www.orionstad.se (copied into dist/ by Vite on build)

Options -MultiViews -Indexes
DirectorySlash Off
RewriteEngine On

# One canonical host: force https + www with a single 301 hop
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.orionstad.se%{REQUEST_URI} [R=301,L,NE]

# Strip trailing slashes (/about/ -> /about) so each page has one URL
RewriteCond %{REQUEST_URI} !^/$
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Old URL that now lives on the terms page
RewriteRule ^privacy-policy$ /terms-of-service [R=301,L]

# Serve prerendered pages: /about -> /about/index.html
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+)$ /$1/index.html [L]

# Anything else that is not a real file gets the 404 page with a real 404 status
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  # Hashed build assets never change; everything else revalidates
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <Else>
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </Else>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain application/xml
</IfModule>
